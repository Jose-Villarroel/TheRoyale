		{
			"name": "2. Clientes (DTOs Limpios)",
			"item": [
				{
					"name": "Listar Clientes (DTO sin contraseñas)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"No retorna contraseñas ni reservas anidadas\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.be.an('array');",
									"    if (data.length > 0) {",
									"        pm.expect(data[0].password).to.be.undefined;",
									"        pm.expect(data[0].reservas).to.be.undefined;",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
