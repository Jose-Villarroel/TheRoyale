		{
			"name": "7. Pruebas de Seguridad (401 & 403)",
			"item": [
				{
					"name": "Caso 401 - Petición sin Token a Endpoint Protegido",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
