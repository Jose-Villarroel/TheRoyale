# Copia este archivo como ".env" (en esta misma carpeta) y pon tu clave de Gemini.
# El .env está en .gitignore: nunca se sube a GitHub. Este .env.example sí, porque no tiene secretos.
GEMINI_API_KEY=
# Plan de visita (opcionales). Sin TICKETMASTER_API_KEY esa fuente queda apagada.
TICKETMASTER_API_KEY=
NYC_OPEN_DATA_APP_TOKEN=
